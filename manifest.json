{
  "manifest_version": 3,
  "name": "TradingView OHLC + Indicator Extractor",
  "short_name": "TV OHLC",
  "version": "1.3.0",
  "description": "Extracts real-time and historical OHLC + active indicator values from any TradingView chart, on any timeframe. Date-range export to Excel-compatible CSV.",
  "minimum_chrome_version": "116",

  "action": {
    "default_popup": "popup.html",
    "default_title": "TV OHLC Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["activeTab", "scripting", "storage"],

  "host_permissions": [
    "*://*.tradingview.com/*",
    "*://*.tradingview.cn/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://*.tradingview.com/*", "*://*.tradingview.cn/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.tradingview.com/*", "*://*.tradingview.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.tradingview.com/*", "*://*.tradingview.cn/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
