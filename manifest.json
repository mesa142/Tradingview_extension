{
  "manifest_version": 3,
  "name": "TradingView Advanced Multi-Condition Alert & Data Extractor",
  "short_name": "TV Alerts",
  "version": "2.0.0",
  "description": "Multi-condition alert generator and high-precision OHLCV & technical indicator extractor for any TradingView chart on any timeframe.",
  "minimum_chrome_version": "116",

  "action": {
    "default_title": "TradingView Alerts & Extractor (Open Side Panel)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "sidePanel",
    "notifications",
    "storage",
    "tabs",
    "scripting",
    "offscreen",
    "activeTab"
  ],

  "host_permissions": [
    "*://*.tradingview.com/*",
    "*://*.tradingview.cn/*",
    "http://localhost:3000/*",
    "ws://localhost:3000/*",
    "http://localhost:8765/*",
    "ws://localhost:8765/*",
    "https://api.telegram.org/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://*.tradingview.com/*", "*://*.tradingview.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["injected.js", "offscreen.html", "offscreen.js"],
      "matches": ["*://*.tradingview.com/*", "*://*.tradingview.cn/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
