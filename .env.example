# ==============================================================================
# TradingView Advanced Multi-Condition Alert Generator — Backend Configuration
# ==============================================================================

# Web Management Console Port (Defaults to 3000; if port 3000 is occupied, auto-fallback to 3050)
PORT=3000

# ------------------------------------------------------------------------------
# Telegram Bot Dispatcher (Backend Setup)
# ------------------------------------------------------------------------------
# 1. Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=

# 2. Get your Chat ID via @userinfobot or @RawDataBot (e.g. 123456789 or group ID -100123456789)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Discord Webhook Dispatcher (Optional)
# ------------------------------------------------------------------------------
# Channel Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Custom Algorithmic HTTP Webhook (Optional)
# ------------------------------------------------------------------------------
# Receives JSON POST with full alert data and indicator snapshots
GENERIC_WEBHOOK_URL=
